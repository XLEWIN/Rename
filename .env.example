# ============================================================================
#  AutoRename Pro — environment variables (Railway template)
# ============================================================================
#  Railway does NOT read .env files.  Copy the keys you need into:
#      Railway → your Service → Variables → RAW / key-value pairs
#  or push them with:  railway variables --set "KEY=value"
#
#  Every key below is optional at boot: config.py ships working defaults, so
#  the container starts even with an empty Variables tab.  Set the ones in the
#  "REQUIRED FOR YOUR OWN BOT" block — otherwise you are running on the
#  original author's credentials that are baked into config.py.
# ============================================================================


# ----------------------------------------------------------------------------
#  REQUIRED FOR YOUR OWN BOT
# ----------------------------------------------------------------------------

# Telegram API credentials → https://my.telegram.org (API development tools)
API_ID=12345678
API_HASH=your_api_hash_here

# Bot token from @BotFather.  Space-separate several tokens to run a fleet
# from one Railway service.  (BOT_TOKEN works too if BOT_TOKENS is empty.)
BOT_TOKENS=123456789:AA...your_bot_token

# Your numeric Telegram user id (settings → @userinfobot).  Receives
# start/shutdown/restart notifications.
OWNER_ID=123456789

# MongoDB connection string (MongoDB Atlas, Railway plugin, or any MONGO URL)
DB_URL=mongodb+srv://user:pass@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=Renamer

# Channels the bot must be ADMIN in.  Use the -100... form of the chat id.
LOG_CHANNEL=-1001234567890
DUMP_CHANNEL=-1001234567890


# ----------------------------------------------------------------------------
#  OPTIONAL — BOT IDENTITY / LINKS / PICTURES
# ----------------------------------------------------------------------------
BOT_NAME=AutoRename
BOT_USERNAME=your_bot_username
OWNER_NAME=YourName
OWNER_USERNAME=your_username
DEVELOPER_NAME=YourName
DEVELOPER_USERNAME=your_username

BOT_CHANNEL_NAME=Updates
BOT_CHANNEL_USERNAME=your_channel
SUPPORT_CHANNEL_NAME=Get Help
SUPPORT_CHANNEL_USERNAME=your_support_channel
OWNER_LNK=https://t.me/your_username

# Pictures shown by /start, force-subscribe and /about (any direct image URL)
START_PIC=https://i.ibb.co/QFN7k0hB/photo-2026-05-02-19-03-00-7635372024495341596.jpg
FORCE_PIC=https://i.ibb.co/VcyqZ1cj/photo-2026-05-02-18-57-28-7635370602861166620.jpg
ABOUT_PIC=https://i.ibb.co/DPG5NNTF/photo-2026-05-21-14-18-33-7642349340601614360.jpg


# ----------------------------------------------------------------------------
#  OPTIONAL — INTEGRATIONS
# ----------------------------------------------------------------------------

# AI chat / voice plugin (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_key

# Poster artwork lookups (themoviedb.org / fanart.tv) for renaming
TMDB_API_KEY=your_tmdb_key
FANART_API_KEY=your_fanart_key

# User-account StringSession — enables 4 GB uploads.  Leave empty to run as a
# plain bot (2 GB limit).  Generate with a pyrogram one-liner if needed.
USER_SESSION_STRING=


# ----------------------------------------------------------------------------
#  OPTIONAL — SERVER / PORT  (Railway handles these for you)
# ----------------------------------------------------------------------------
# PORT is injected by Railway at runtime — the bot binds 0.0.0.0:$PORT
# automatically.  Only set WEBHOOK_PORT if you must pin the port yourself.
WEBHOOK=true
# WEBHOOK_PORT=8023

# Optional ffmpeg/ffprobe overrides (auto-detected from PATH inside the image)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe


# ----------------------------------------------------------------------------
#  OPTIONAL — TUNING (defaults shown)
# ----------------------------------------------------------------------------
WORKERS=12
CONCURRENT_TRANSMISSIONS=8
SLEEP_THRESHOLD=120

GLOBAL_CONCURRENT_LIMIT=50
AUDIO_ENCODE_PARALLEL_LIMIT=2
EDIT_API_CONCURRENCY=16
SEND_API_CONCURRENCY=12

MAX_RETRIES=5
RETRY_DELAY=3
MESSAGE_TIMEOUT=30
PROGRESS_MIN_PERCENT_DELTA=5.0

STORAGE_CLEANUP_ENABLED=true
STORAGE_CLEANUP_MAX_AGE=5400
STORAGE_CLEANUP_INTERVAL=600

# Force-subscribe link lifetime in seconds (0 = never expire)
FSUB_LINK_EXPIRY=0
